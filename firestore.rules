rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// This is intentionally not deployed automatically: test it in Firebase first.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /quotations-followups/{recordId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /customers/{recordId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /agents/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /sending phone/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
